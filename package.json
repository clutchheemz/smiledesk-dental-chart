    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
